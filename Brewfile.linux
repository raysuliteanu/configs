# Provides audio and MIDI functionality to the Linux operating system
brew "alsa-lib"
# Collection of Linux utilities
brew "util-linux"
# Message bus system, providing inter-application communication
brew "dbus"
# User-space interfaces to POSIX 1003.1e capabilities
brew "libcap"
# Library for querying compressed XML metadata
brew "libxmlb"
# System and service manager
brew "systemd", link: true
# Tools and libraries to work with AppStream metadata
brew "appstream"
# X.Org: Protocol Headers
brew "xorgproto"
