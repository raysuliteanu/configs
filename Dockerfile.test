# Test Dockerfile for install-deps.sh
# Simulates a fresh Ubuntu system for testing installation scripts

FROM ubuntu:24.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install minimal dependencies needed to bootstrap the install script
RUN apt-get update && \
    apt-get install -y \
    sudo \
    curl \
    git \
    ca-certificates \
    locales \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set up locale
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Ubuntu 24.04 comes with 'ubuntu' user (UID 1000) by default
# Add it to sudoers and use it for testing
RUN if id -u ubuntu > /dev/null 2>&1; then \
    echo "ubuntu ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers; \
    else \
    groupadd --gid 1000 testuser && \
    useradd --uid 1000 --gid 1000 -m testuser && \
    echo "testuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers; \
    fi

# Switch to the non-root user
USER 1000:1000

# Set working directory to user's home
WORKDIR /home/ubuntu

# Copy the installation scripts to home directory
COPY --chown=1000:1000 . configs/

WORKDIR /home/ubuntu/configs

# Default command: run bash for interactive testing
CMD ["/bin/bash"]
